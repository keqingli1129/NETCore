@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-avatar">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5z" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M20.59 20.59A10 10 0 0 0 3.41 20.59" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your account to continue</p>

        <form id="account" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

            <label class="form-label">Email</label>
            <div class="input-group mb-3">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 8.5v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 7l-9 6-9-6" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <label class="form-label">Password</label>
            <div class="input-group mb-2">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                </div>
            </div>

            <div class="d-grid mb-3">
                <button id="login-submit" type="submit" class="btn btn-maroon btn-lg">Sign In</button>
            </div>
        </form>

            <div class="divider mb-3"><span>or continue with</span></div>

            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="text-center text-muted mb-2">No external authentication configured.</div>
            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            if (string.Equals(provider.Name, "SAML", StringComparison.OrdinalIgnoreCase))
                            {
                                var display = provider.DisplayName ?? provider.Name;
                                <button type="submit" name="provider" value="SAML" class="btn external-btn d-flex align-items-center" title="Continue with @display">
                                    <span class="me-3">🔐</span>
                                    <span class="flex-grow-1 text-start">Continue with @display</span>
                                </button>
                                continue;
                            }
                            <button type="submit" name="provider" value="@provider.Name" class="btn external-btn d-flex align-items-center" title="Continue with @provider.DisplayName">
                                @if (provider.Name?.ToLower().Contains("google") == true)
                                {
                                    @:<span class="me-3"> <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.9 0 7.1 1.4 9.6 3.9l7.2-7.2C36 2.1 30.5 0 24 0 14.7 0 6.8 5.6 3.1 13.6l8.6 6.7C13.8 14.1 18.4 9.5 24 9.5z"/><path fill="#34A853" d="M46.9 24.5c0-1.4-.1-2.8-.4-4.1H24v8.1h12.8c-.6 3.1-2.4 5.6-5.1 7.3l8 6.3c4.7-4.3 7.2-11 7.2-17.6z"/><path fill="#4A90E2" d="M10.2 29.8A14.5 14.5 0 0 1 9 24.5c0-1.6.2-3.1.6-4.6L1 13.1C-1.3 17.3-2.5 21.8-2.5 26.5c0 4.6 1 9 3.5 12.8l8.2-9.5z"/><path fill="#FBBC05" d="M24 48c6.5 0 11.9-2.1 15.9-5.7l-8-6.3c-2.2 1.5-5 2.4-7.9 2.4-5.6 0-10.2-4.6-11.9-10.7L3.1 34.4C6.8 42.4 14.7 48 24 48z"/></svg> </span>
                                }
                                else if (provider.Name?.ToLower().Contains("microsoft") == true || provider.Name?.ToLower().Contains("azure") == true)
                                {
                                    @:<span class="me-3"> <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="#F25022"/><rect x="13" y="1" width="10" height="10" fill="#7FBA00"/><rect x="1" y="13" width="10" height="10" fill="#00A4EF"/><rect x="13" y="13" width="10" height="10" fill="#FFB900"/></svg> </span>
                                }
                                <span class="flex-grow-1 text-start">Continue with @provider.DisplayName</span>
                            </button>
                        }
                    </div>
                </form>
            }

            <div class="text-center mt-3">
                <p class="mb-1">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a></p>
                <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
            </div>
        
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
