@{
    ViewData["Title"] = $"Manage Users for Role: {ViewBag.RoleName}";
    var usersInRole = ViewBag.UsersInRole as List<Microsoft.AspNetCore.Identity.IdentityUser>;
    var usersNotInRole = ViewBag.UsersNotInRole as List<Microsoft.AspNetCore.Identity.IdentityUser>;
    string roleId = ViewBag.RoleId as string;
    string roleName = ViewBag.RoleName as string;
}

<h1>Manage Users for Role: @roleName</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h3>Users in this Role</h3>
        <table class="table table-bordered">
            <thead>
                <tr><th>User Name</th><th>Email</th><th>Action</th></tr>
            </thead>
            <tbody>
            @if (usersInRole != null && usersInRole.Any())
            {
                foreach (var user in usersInRole)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>
                            <form asp-action="RemoveUserFromRole" method="post" style="display:inline">
                                <input type="hidden" name="roleId" value="@roleId" />
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3">No users in this role.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h3>Users not in this Role</h3>
        <table class="table table-bordered">
            <thead>
                <tr><th>User Name</th><th>Email</th><th>Action</th></tr>
            </thead>
            <tbody>
            @if (usersNotInRole != null && usersNotInRole.Any())
            {
                foreach (var user in usersNotInRole)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>
                            <form asp-action="AddUserToRole" method="post" style="display:inline">
                                <input type="hidden" name="roleId" value="@roleId" />
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Add</button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3">No users available to add.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<p>
    <a asp-action="Index" class="btn btn-secondary">Back to Roles</a>
</p>
