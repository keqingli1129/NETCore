<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FBISD</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CoreMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Utility Bar -->
    <div class="utility-bar">
        @await Html.PartialAsync("_LoginPartial")
    </div>

    <!-- Site Header -->
    <header class="site-header">
        <div class="logo-group">
            <img src="~/images/logo.png" alt="FBISD Logo" />
            <div class="logo-text">
                <h1>FORT BEND ISD</h1>
                <span>Established 1959</span>
            </div>
        </div>
        <div class="mission-text">
            FBISD exists to inspire and equip all students to pursue futures beyond what they can imagine.
        </div>
    </header>

    <!-- Main Navigation -->
    <nav class="main-nav">
        <ul>
            <li><a class="active" asp-controller="Home" asp-action="Index">Home</a></li>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* Orders: visible to Admin and User roles *@
                @if (User.IsInRole("Admin") || User.IsInRole("User"))
                {
                    <li><a asp-controller="Orders" asp-action="Index">Orders</a></li>
                }

                @* Roles: visible to Admin only *@
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-controller="Roles" asp-action="Index">Roles</a></li>
                }
            }
        </ul>
    </nav>

   @*  <!-- Quick Links -->
    <div class="quick-links">
        <a href="#">I WOULD LIKE TO...</a>
    </div> *@

    <!-- Hero Section -->
    @* <section class="hero-section">
        <div class="hero-carousel">
            <img src="~/images/hero-placeholder.jpg" alt="Hero banner" />
            <div class="carousel-controls">
                <button aria-label="Previous">&lsaquo;</button>
                <button aria-label="Pause">&#9646;&#9646;</button>
                <button aria-label="Next">&rsaquo;</button>
            </div>
        </div>
        <aside class="events-sidebar">
            <div class="events-header">Upcoming Events</div>
            <div class="event-item">
                <p class="event-month">MAY</p>
                <p class="event-day">6</p>
                <p class="event-weekday">Wednesday</p>
                <p class="event-title">In-Person Enrollment Event</p>
                <p class="event-time">4:00 PM – 8:00 PM</p>
            </div>
            <div class="event-item">
                <p class="event-title">Special Called Meeting - Board Self Evaluation</p>
            </div>
        </aside>
    </section> *@

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <!-- Motto Bar -->
        <div class="footer-motto">
            <span>INSPIRE</span> &bull; <span>EQUIP</span> &bull; <span>IMAGINE</span>
        </div>

        <!-- Main Footer Content -->
        <div class="footer-main">
            <div class="footer-image">
                <img src="~/images/footer-building.png" alt="FBISD Building" />
            </div>
            <div class="footer-contact">
                <div class="footer-logo-text">FBISD</div>
                <p>📍 16431 Lexington Blvd.<br />Sugar Land, TX 77479</p>
                <p>📞 (281) 634-1000</p>
            </div>
            
        </div>

        <!-- Disclaimer -->
        <div class="footer-disclaimer">
            <p>The Fort Bend Independent School District, an Equal Opportunity Educational Provider and Employer, does not discriminate on the basis of race, color, religion, gender, sex, national origin, disability and/or age, military status, genetic information, or any other basis prohibited by law in educational programs or activities that it operates or in employment decisions.</p>
        </div>

        <!-- Bottom Bar -->
        <div class="footer-bottom">
            <p>Questions or Feedback? &middot; Web Community Manager Privacy Policy (Updated)<br />Copyright &copy; 2026 Finalsite - all rights reserved.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
