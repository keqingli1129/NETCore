@model IEnumerable<CoreMVC.Domain.Entities.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Employee</th>
            <th>Order Date</th>
            <th>Required Date</th>
            <th>Shipped Date</th>
            <th>Ship Via</th>
            <th>Freight</th>
            <th>Ship City</th>
            <th>Ship Country</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderId</td>
                <td>@item.Customer?.CompanyName</td>
                <td>
                    @if (item.Employee is not null)
                    {
                        @($"{item.Employee.FirstName} {item.Employee.LastName}")
                    }
                </td>
                <td>@item.OrderDate?.ToString("yyyy-MM-dd")</td>
                <td>@item.RequiredDate?.ToString("yyyy-MM-dd")</td>
                <td>@item.ShippedDate?.ToString("yyyy-MM-dd")</td>
                <td>@item.ShipViaNavigation?.CompanyName</td>
                <td>@item.Freight?.ToString("C")</td>
                <td>@item.ShipCity</td>
                <td>@item.ShipCountry</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.OrderId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var pageNumber = (int)ViewData["PageNumber"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var pageSize = (int)ViewData["PageSize"]!;
    var totalCount = (int)ViewData["TotalCount"]!;
}

<nav aria-label="Order pagination">
    <ul class="pagination">
        <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)" asp-route-pageSize="@pageSize">Previous</a>
        </li>
        @for (var i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@pageSize">@i</a>
            </li>
        }
        <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)" asp-route-pageSize="@pageSize">Next</a>
        </li>
    </ul>
</nav>
<p class="text-muted">Showing page @pageNumber of @totalPages (@totalCount total orders)</p>
