@model PlainNetCoreMVC.Models.PaginatedList<PlainNetCoreMVC.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">Customers</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().CompanyName)</th>
                        <th>@Html.DisplayNameFor(model => model.First().ContactName)</th>
                        <th>@Html.DisplayNameFor(model => model.First().ContactTitle)</th>
                        <th>@Html.DisplayNameFor(model => model.First().City)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Region)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Country)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Phone)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td><strong>@Html.DisplayFor(model => item.CompanyName)</strong></td>
                        <td>@Html.DisplayFor(model => item.ContactName)</td>
                        <td>@Html.DisplayFor(model => item.ContactTitle)</td>
                        <td>@Html.DisplayFor(model => item.City)</td>
                        <td>@Html.DisplayFor(model => item.Region)</td>
                        <td>@Html.DisplayFor(model => item.Country)</td>
                        <td>@Html.DisplayFor(model => item.Phone)</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-info" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    const int maxVisiblePages = 5;
    var startPage = Math.Max(1, Model.PageIndex - maxVisiblePages / 2);
    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
    startPage = Math.Max(1, endPage - maxVisiblePages + 1);
}

<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="1" title="First">
                &laquo;
            </a>
        </li>
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" title="Previous">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        @for (var i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" title="Next">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" title="Last">
                &raquo;
            </a>
        </li>
    </ul>
</nav>
