
@model PlainNetCoreMVC.Models.PaginatedList<PlainNetCoreMVC.Models.Category>

@{
    ViewData["Title"] = "Categories (API)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">Categories (from Web API)</h1>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td><strong>@item.CategoryName</strong></td>
                        <td>@item.Description</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    const int maxVisiblePages = 5;
    var startPage = Math.Max(1, Model.PageIndex - maxVisiblePages / 2);
    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
    startPage = Math.Max(1, endPage - maxVisiblePages + 1);
}

<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="FromApi" asp-route-pageNumber="1" title="First">
                &laquo;
            </a>
        </li>
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="FromApi" asp-route-pageNumber="@(Model.PageIndex - 1)" title="Previous">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        @for (var i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="FromApi" asp-route-pageNumber="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="FromApi" asp-route-pageNumber="@(Model.PageIndex + 1)" title="Next">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="FromApi" asp-route-pageNumber="@Model.TotalPages" title="Last">
                &raquo;
            </a>
        </li>
    </ul>
</nav>
