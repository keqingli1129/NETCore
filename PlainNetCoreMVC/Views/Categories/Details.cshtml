@model PlainNetCoreMVC.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Category Details</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CategoryName)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.CategoryName)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                    <dt class="col-sm-3">Picture</dt>
                    <dd class="col-sm-9">
                        @if (Model.Picture != null && Model.Picture.Length > 0)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(Model.Picture)" alt="Category Picture" class="img-thumbnail" style="max-height: 200px;" />
                        }
                        else
                        {
                            <span class="text-muted">No picture available</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>
        </div>
    </div>
</div>
